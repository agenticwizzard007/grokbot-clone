# Model API keys are optional when each user connects a subscription in Settings → Subscriptions.
# See docs/cli-subscriptions.md. Embedded login saves a private profile per account on the server.
# Copy to .env and fill in. Never commit .env.
# Keys can also be pasted in the app (Settings → API keys); those override this file.

# Subscription CLI profiles: persist this directory with the database across deployments.
# CLI_PROFILES_DIR=/data/cli-profiles   # default: cli-profiles/ beside DB_PATH
# SWARM_CLI_SERVER_LOGIN=0             # disable hosted login/generation; computer bridge still works
# Optional absolute executable paths (otherwise bundled CLIs and python3 on PATH are used):
# SWARM_CLI_CODEX_PATH=/usr/local/bin/codex
# SWARM_CLI_CLAUDE_PATH=/usr/local/bin/claude
# SWARM_CLI_PYTHON_PATH=/usr/bin/python3

# Models: OpenRouter (one key for Claude, GPT, Gemini, ...) and/or a compatible direct provider.
OPENROUTER_API_KEY=     # https://openrouter.ai/keys
OPENROUTER_MODEL=openai/gpt-4.1
# LLM_PROVIDER=openrouter   # openrouter | direct (default: openrouter when OPENROUTER_API_KEY is set)
DIRECT_API_KEY=            # key for a compatible text-model provider
DIRECT_MODEL=openai/gpt-4.1
# DIRECT_BASE_URL=https://api.openai.com/v1   # http://localhost:8790/v1 to use tests/mock-provider.mjs instead
COMPOSIO_API_KEY=       # Platform project key, or authorized developer user key (uak_...); not a personal MCP key (ck_...)
COMPOSIO_ORG_ID=        # required with a user key; pins the server to this organization
COMPOSIO_PROJECT_ID=    # required with a user key; pins the server to this developer project
# Bots' computers: "desktop" = your own PC's full desktop, default browser and a shell via the
# companion; "local" = a private Chrome browser on your own PC via the companion
# (Settings → Computer → Use this computer / Connect your PC); "orgo" = Orgo cloud VMs (needs ORGO_API_KEY).
COMPUTER_PROVIDER=local
# "cloudvm" = every user gets their own cloud VM, created automatically at sign-up, one screen per Bot
# (see README → Cloud VMs). VM_DRIVER=fly uses Fly.io Machines; VM_DRIVER=fake runs local test VMs.
# VM_DRIVER=fly
# FLY_API_TOKEN=          # cloudvm + fly: a token for FLY_VM_APP
# FLY_VM_APP=             # the Fly app that holds every user's VM
# VM_IMAGE=registry.fly.io/<FLY_VM_APP>:<version>   # built from infra/vm-image
# VM_REGION=              # optional; default: Fly picks
# VM_BASE_MEMORY_MB=2048  VM_SCREEN_MEMORY_MB=768  VM_CPUS=2  VM_VOLUME_GB=10
# FILES_DIR=data/files  # where local computers' Library files are kept (default: next to the database)
ORGO_API_KEY=           # orgo only: Orgo key (sk_live_...) that can create computers in ORGO_WORKSPACE_ID
ORGO_WORKSPACE_ID=      # Orgo workspace holding every user's box
ORGO_RAM_GB=8           # box size: 8 GB / 2 vCPU (Medium); 16/4 recommended for 4 active bots
ORGO_CPU=2
ORGO_RESOLUTION=1280x800x24
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=         # openssl rand -hex 32 (also encrypts keys saved in the app; keep it stable)
# ADMIN_USER_IDS=        # account ids (usr_…) that may change API keys and server settings in the app
# ADMIN_PHONES=          # owner numbers: may sign up first; mapped to administrator accounts once when an older server upgrades
DEV_LOGIN=1             # 1 enables POST /api/auth/dev (local testing only)
# SWARM_ROLE=standalone  # required when NODE_ENV=production: one shared server for all accounts (fly.toml sets it)

# Platform voice: one admin-managed xAI key for ALL existing/new accounts, including CLI users.
# Set in Settings → API keys → Platform voice, or in the deployment's secret store.
XAI_API_KEY=             # https://console.x.ai — enable realtime voice permissions and account credits
# XAI_BASE_URL=https://api.x.ai/v1
# Legacy compatible direct voice servers (used only when platform voice is not configured):
# DIRECT_VOICE_MODEL=voice-realtime-latest
# DIRECT_STT_MODEL=audio-transcribe-latest

# Texting (optional): iMessage/SMS/WhatsApp through Inkbox (inkbox.ai). Easiest in the app: Settings → Messaging.
# INKBOX_ADMIN_API_KEY=        # org admin key; the app creates the line's identity, its scoped key and signing key
# INKBOX_HANDLE=swarm        # the line's handle; people text "connect @<handle>" to Inkbox's router number
# MESSAGING_SIGNUP_MODE=invite # invite (invite links + waitlist) | open | closed
# MESSAGING_SIGNUPS_PER_DAY=50 # new accounts by text per day
# MESSAGING_DAILY_MESSAGES=200 # messages per day for each account created by text (0 = no limit)
# MESSAGING_MEMBER_INVITES=5   # invite links each member can share
# Without platform voice, API-mode accounts can use OpenRouter for voice notes and replies.
# OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
# OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts   # provider voices, the same ones Bots use on live calls
# Routine guardrails (every run is a model call; 0 turns a limit off). See README → Routines and limits.
# ROUTINE_MIN_INTERVAL_MIN=15          # timed routines run at most this often
# ROUTINE_MAX_PER_BOT=10               # active routines per Bot
# ROUTINE_MAX_PER_USER=25              # active routines per account
# ROUTINE_MAX_RUNS_PER_DAY=100         # runs per account in any 24 hours (timed, event and "run now")
# ROUTINE_EVENT_MIN_GAP_SEC=60         # event bursts within this window are combined into one run
# ROUTINE_PAUSE_IF_USER_IDLE_DAYS=30   # pause routines of accounts whose user hasn't sent a message in this long

# Latency diagnostics and computer responsiveness (see docs/performance.md).
# SWARM_LOG_LATENCY=1                # server: queue, preparation, model and tool durations; no message content
# COMPUTER_SETTLE_MS=150             # server: short pause before post-action screenshots (0–2000 ms)
# SWARM_VIEWER_FPS=20                # companion: watching capture target (1–60), or --viewer-fps
# SWARM_CONTROL_FPS=20               # companion: taking-control capture target (1–60), or --control-fps
# SWARM_VIEWER_BUDGET_FPS=20         # companion: aggregate Linux desktop capture budget across watched screens
# SWARM_VIEWER_WIDTH=1920            # companion: live viewer width; encodes only while a visible viewer is connected
# SWARM_SCREEN_WIDTH=1920            # companion: stable cloud desktop size; agent screenshots stay capped at 1280 wide
# SWARM_SCREEN_HEIGHT=1080
# SWARM_BROWSER_SETTLE_MS=150         # companion: Playwright post-action settling allowance; readiness checks remain
# SWARM_FFMPEG=ffmpeg                 # companion: optional encoder executable override

# Sign in with Apple (optional): web Services ID + the iOS/Mac App IDs, grouped under one primary App ID.
# Never put the private key in web/ or apple/. See docs/apple-sign-in.md.
# APPLE_TEAM_ID=          # 10-character developer Team ID
# APPLE_KEY_ID=           # ID of a key with Sign in with Apple enabled (not an App Store Connect API key)
# APPLE_SERVICE_ID=       # Services ID for web OAuth
# APPLE_IOS_CLIENT_ID=so.swarms.app
# APPLE_MACOS_CLIENT_ID=so.swarms.app.macos
# APPLE_PRIVATE_KEY=     # .p8 PEM; literal \n escapes are accepted, or use the file option below
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple-sign-in.p8
# Register https://<SERVER_URL host>/api/auth/apple/callback as the Services ID return URL.
