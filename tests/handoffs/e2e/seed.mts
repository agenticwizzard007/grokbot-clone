import fs from 'node:fs';
import { db } from '../../../server/src/db.js';
import { createBot } from '../../../server/src/bots.js';
import { appendRow } from '../../../server/src/store.js';
import { replaceLinks } from '../../../server/src/handoffs/link-service.js';
import { saveMcpServer } from '../../../server/src/mcp/store.js';
import { recordFlowConnections } from '../../../server/src/flow/cache.js';
const file = process.env.PHONE_QA_FIXTURE_FILE!;
const f = JSON.parse(fs.readFileSync(file, 'utf8')), userId = f.userId, maker = f.bot.id;
const checker = (db.prepare("SELECT id FROM bots WHERE user_id=? AND id<>? AND kind='agent'").get(userId, maker) as any).id;
db.prepare("UPDATE bots SET name='Maker',instructions='1. Review the brief.\n2. Draft release notes.' WHERE id=?").run(maker);
db.prepare("UPDATE bots SET name='Checker',instructions='Check the release note and submit a verdict.' WHERE id=?").run(checker);
const empty = createBot(userId, { name: 'Empty fixture' });
const suggested = createBot(userId, { name: 'Suggested fixture' });
db.prepare('UPDATE bots SET suggestions_snapshot=? WHERE id=?').run(JSON.stringify({ version: 1, filterVersion: 'purpose-2', computedAt: 1, hasContext: true, suggestions: [{ slug: 'github', name: 'GitHub', noAuth: false }] }), suggested.id);
db.prepare("UPDATE bot_setups SET onboarding_status='active'").run();
db.prepare("INSERT INTO routines(id,bot_id,name,prompt,schedule,timezone,enabled,created_at) VALUES('hoh-routine',?,'Review placeholder sources','Review the brief','0 9 * * 1','UTC',1,?)").run(maker, Date.now());
db.prepare("INSERT INTO skills(id,bot_id,name,body,created_at) VALUES('hoh-skill',?,'Fixture verification','Verify placeholder sources.',?)").run(maker, Date.now());
db.prepare("INSERT INTO memories(id,bot_id,text,created_at) VALUES('hoh-memory',?,'Placeholder reference.',?)").run(maker, Date.now());
db.prepare("INSERT INTO tasks(id,bot_id,title,state,note,created_at,updated_at) VALUES('hoh-task',?,'Placeholder release draft','done','Version 1.0 ready for review.',?,?)").run(maker, Date.now(), Date.now());
const mcp = saveMcpServer(userId, { name: 'Fixture library', transport: 'http', url: 'https://example.test/mcp', botIds: [maker], enabled: false });
recordFlowConnections(userId, []);
replaceLinks(userId, maker, [{ toBotId: checker, mode: 'suggest', trigger: 'any_run', template: 'Review {title}.', autoApproveLoops: false }]);
appendRow(f.room, 'message', { type: 'message', role: 'assistant', text: 'Placeholder group draft ready for review.', from: { kind: 'bot', id: maker, name: 'Maker' } });
fs.writeFileSync(file, JSON.stringify({ ...f, maker, checker, empty: empty.id, suggested: suggested.id, mcp: mcp.id }));
db.close();
