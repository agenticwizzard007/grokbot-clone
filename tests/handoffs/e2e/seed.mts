import fs from 'node:fs';
import { db } from '../../../server/src/db.js';
import { createBot } from '../../../server/src/bots.js';
import { appendRow } from '../../../server/src/store.js';
import { replaceLinks } from '../../../server/src/handoffs/link-service.js';
import { saveMcpServer } from '../../../server/src/mcp/store.js';
import { saveOutput } from '../../../server/src/handoffs/outputs.js';
import { recordArtifact } from '../../../server/src/deliverables/artifacts.js';
import { recordFlowConnections } from '../../../server/src/flow/cache.js';
const file = process.env.PHONE_QA_FIXTURE_FILE!;
const f = JSON.parse(fs.readFileSync(file, 'utf8')), userId = f.userId, maker = f.bot.id;
const checker = (db.prepare("SELECT id FROM bots WHERE user_id=? AND id<>? AND kind='agent'").get(userId, maker) as any).id;
db.prepare("UPDATE bots SET name='Maker',instructions='1. Review the brief.\n2. Draft release notes.' WHERE id=?").run(maker);
db.prepare("UPDATE bots SET name='Checker',instructions='Check the release note and submit a verdict.' WHERE id=?").run(checker);
const empty = createBot(userId, { name: 'New agent' });
const securityMaker = createBot(userId, { name: 'Document writer' });
const securityChecker = createBot(userId, { name: 'Document reviewer' });
const suggested = createBot(userId, { name: 'Suggested apps' });
db.prepare('UPDATE bots SET suggestions_snapshot=? WHERE id=?').run(JSON.stringify({ version: 1, filterVersion: 'purpose-2', computedAt: 1, hasContext: true, suggestions: [{ slug: 'github', name: 'GitHub', noAuth: false }] }), suggested.id);
db.prepare("UPDATE bot_setups SET onboarding_status='active'").run();
db.prepare("INSERT INTO routines(id,bot_id,name,prompt,schedule,timezone,enabled,created_at) VALUES('hoh-routine',?,'Review release sources','Review the brief','0 9 * * 1','UTC',1,?)").run(maker, Date.now());
db.prepare("INSERT INTO skills(id,bot_id,name,body,created_at) VALUES('hoh-skill',?,'Fact checking','Verify every source.',?)").run(maker, Date.now());
db.prepare("INSERT INTO memories(id,bot_id,text,created_at) VALUES('hoh-memory',?,'Release notes reference.',?)").run(maker, Date.now());
db.prepare("INSERT INTO tasks(id,bot_id,title,state,note,created_at,updated_at) VALUES('hoh-task',?,'Release draft','done','Version 1.0 ready for review.',?,?)").run(maker, Date.now(), Date.now());
const mcp = saveMcpServer(userId, { name: 'Reference library', transport: 'http', url: 'https://example.test/mcp', botIds: [maker], enabled: false });
recordFlowConnections(userId, [{ id: 'github', name: 'GitHub' }]);
recordArtifact({ userId, botId: maker, filename: 'release-notes.md', content: 'Version 1.0 improves search. Try it today.' });
db.prepare("INSERT INTO routines(id,bot_id,name,prompt,schedule,enabled,created_at,trigger_id) VALUES('hoh-event',?,'New issue','Review a new issue','0 9 * * 1',0,?,'test-event')").run(maker, Date.now());
db.prepare("INSERT INTO users(id,email,name,created_at) VALUES('hoh-other','other@example.test','Other test account',?)").run(Date.now());
const other = createBot('hoh-other', { name: 'Other account agent' });
const foreignOutput = saveOutput({ userId: 'hoh-other', botId: other.id, source: 'message', body: 'Other account private test output.', final: true });
replaceLinks(userId, maker, [{ toBotId: checker, mode: 'suggest', trigger: 'any_run', template: 'Review {title}.', autoApproveLoops: false }]);
replaceLinks(userId, checker, [{ toBotId: maker, mode: 'suggest', trigger: 'any_run', template: 'Review {title}.', autoApproveLoops: false }]);
appendRow(f.room, 'message', { type: 'message', role: 'assistant', text: 'The release draft is ready for review.', from: { kind: 'bot', id: maker, name: 'Maker' } });
fs.writeFileSync(file, JSON.stringify({ ...f, maker, checker, empty: empty.id, suggested: suggested.id, mcp: mcp.id, foreignOutput: foreignOutput.id, securityMaker: securityMaker.id, securityChecker: securityChecker.id }));
db.close();
