# Local-only settings. platform-local-up.sh fills blank secrets with random values
# in a 0600 env file outside git. No external account credentials are needed.
# Same repo Dockerfile image for platform, provisioner, gateway and migration.
SWARM_IMAGE=swarm-platform:local
# Exact checkout revision for the build manifest. The local-up script supplies it.
SWARM_BUILD_REVISION=
# Compose project name separates all named volumes and networks.
COMPOSE_PROJECT_NAME=swarm-platform
# Match the host key file owner for non-root services. local-up fills these on creation.
LOCAL_UID=1000
LOCAL_GID=1000
# Absolute directory outside git: private/public PEM and local KMS seed, all 0600.
PLATFORM_KEYS_DIR=
# Host loopback HTTPS ports; Caddy serves TLS on 8443/8444 inside its container.
PLATFORM_HTTPS_PORT=8443
GATEWAY_HTTPS_PORT=8444
# Explicit permission for emulator endpoint overrides in production-built images.
SWARM_ALLOW_LOCAL_CLOUD=1
# Local-only hold. 0 starts the real provisioner with all existing release gates.
SWARM_LOCAL_PROVISIONER_HOLD=1
# Shared platform/provisioner admission cap; signup policy remains invite-only.
PLATFORM_TENANT_LIMIT=100
# Optional isolated-platform ledger. The local provisioner hold still applies.
TENANT_METERING=0
# Passed through for MT-B. No Docker socket is granted by this compose file.
TENANT_DRIVER=fly
# Required only when releasing hold: exact qualified host image digest and region.
TENANT_HOST_IMAGE=
TENANT_REGION=local
# Required only by an enabled Fly driver. Leave empty for all local checks.
FLY_API_TOKEN=
FLY_ORG_SLUG=
# Separate PostgreSQL bootstrap administrator, schema owner and runtime passwords.
# Use URL-safe values for owner/runtime passwords because they appear in DB URLs.
POSTGRES_ADMIN_PASSWORD=
POSTGRES_OWNER_PASSWORD=
POSTGRES_RUNTIME_PASSWORD=
# At least 32 random bytes. Only the platform receives this session secret.
SESSION_SECRET=
# Local KMS signing credentials only, distinct from MinIO object storage keys.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Must match the offline seed. To change, regenerate only in a new disposable stack.
TENANT_KMS_KEY_ID=11111111-2222-4333-8444-555555555555
# MinIO administrative credentials go only to MinIO and its initialization job.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Local MinIO SSE key: local-key:<base64 of 32 bytes>. Separate from tenant KMS.
MINIO_KMS_SECRET_KEY=
# Prefix-scoped MinIO application user. Never supplied to KMS or tenant workloads.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Offline placeholders used only to construct the gateway. Egress is blocked.
# No Composio account, OAuth client, webhook delivery or provider call is enabled.
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
# Standalone uses its own env file, separate from this platform credential file.
# Set SESSION_SECRET and normal self-host settings in that file (see docs).
STANDALONE_ENV_FILE=
STANDALONE_PORT=8787
