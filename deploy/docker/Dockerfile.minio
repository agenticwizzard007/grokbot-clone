# Local emulators only. Public upstream container pulls may require an account;
# pinned source builds keep local bootstrap independent of registry credentials.
FROM golang:1.24.7-alpine AS source
RUN apk add --no-cache git ca-certificates
ENV CGO_ENABLED=0
WORKDIR /src
FROM source AS minio-build
RUN git init && git remote add origin https://github.com/minio/minio.git \
 && git fetch --depth 1 origin 07c3a429bfed433e49018cb0f78a52145d4bedeb \
 && git checkout --detach FETCH_HEAD \
 && go build -trimpath -o /out/minio .
FROM source AS mc-build
RUN git init && git remote add origin https://github.com/minio/mc.git \
 && git fetch --depth 1 origin 7394ce0dd2a80935aded936b09fa12cbb3cb8096 \
 && git checkout --detach FETCH_HEAD \
 && go build -trimpath -o /out/mc .
FROM alpine:3.22 AS minio
RUN apk add --no-cache ca-certificates curl
COPY --from=minio-build /out/minio /usr/local/bin/minio
ENTRYPOINT ["minio"]
FROM alpine:3.22 AS mc
RUN apk add --no-cache ca-certificates
COPY --from=mc-build /out/mc /usr/local/bin/mc
ENTRYPOINT ["mc"]
